{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "dms-periods-overview"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      },
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "frser-sqlite-datasource",
            "version": "v0",
            "datasource": {
              "name": "sqlite-periods"
            },
            "spec": {
              "datasource": {
                "type": "frser-sqlite-datasource",
                "uid": "sqlite-periods"
              },
              "queryText": "SELECT start AS time, \"end\" AS timeEnd, 'problem: ' || channel || ', ' || kind || CASE WHEN note != '' THEN ' — ' || note ELSE '' END AS text FROM issues WHERE period = '${period}'",
              "queryType": "table",
              "rawQueryText": "SELECT start AS time, \"end\" AS timeEnd, 'problem: ' || channel || ', ' || kind || CASE WHEN note != '' THEN ' — ' || note ELSE '' END AS text FROM issues WHERE period = '${period}'",
              "refId": "Anno",
              "timeColumns": [
                "time",
                "timeEnd"
              ]
            }
          },
          "enable": true,
          "hide": false,
          "iconColor": "orange",
          "name": "Problemy z katalogu"
        }
      },
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "frser-sqlite-datasource",
            "version": "v0",
            "datasource": {
              "name": "sqlite-periods"
            },
            "spec": {
              "datasource": {
                "type": "frser-sqlite-datasource",
                "uid": "sqlite-periods"
              },
              "queryText": "SELECT start AS time, \"end\" AS timeEnd, 'ręczny ' || role AS text FROM signal_events WHERE period = '${period}' AND synthetic = 1",
              "queryType": "table",
              "rawQueryText": "SELECT start AS time, \"end\" AS timeEnd, 'ręczny ' || role AS text FROM signal_events WHERE period = '${period}' AND synthetic = 1",
              "refId": "Anno",
              "timeColumns": [
                "time",
                "timeEnd"
              ]
            }
          },
          "enable": true,
          "hide": false,
          "iconColor": "yellow",
          "name": "Ręczne zdarzenia"
        }
      },
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "datasource",
            "version": "v0",
            "datasource": {
              "name": "grafana"
            },
            "spec": {
              "queryType": "timeRegions",
              "refId": "Anno",
              "timeRegion": {
                "mode": "cron",
                "cronExpr": "0 0 * * *",
                "duration": "1m",
                "timezone": "Europe/Warsaw"
              }
            }
          },
          "enable": true,
          "hide": false,
          "iconColor": "rgba(255, 255, 255, 0.6)",
          "name": "Północ (czas lokalny)"
        }
      }
    ],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Okresy (klik w okres: wybór okresu i jego zakresu czasu)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "frser-sqlite-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "sqlite-periods"
                      },
                      "spec": {
                        "queryText": "SELECT label AS okres, CASE time WHEN 'real' THEN 'rzeczywisty' WHEN 'estimated' THEN 'szacowany ±' || printf('%g', time_uncertainty_h) || ' h' ELSE 'zegar urządzenia' END AS czas,\n  start AS od, \"end\" AS do, printf('%.1f h', (\"end\" - start) / 3600.0) AS długość,\n  channel_dispense AS odsyp, channel_refill AS zasyp, channel_temperatures AS temperatury,\n  CASE checked WHEN 1 THEN 'tak' ELSE 'nie' END AS sprawdzony, legacy_name AS \"dawna nazwa\", id,\n  CAST(start * 1000 AS INTEGER) AS from_ms, CAST(\"end\" * 1000 AS INTEGER) + 1000 AS to_ms\nFROM period ORDER BY site, period_id",
                        "queryType": "table",
                        "rawQueryText": "SELECT label AS okres, CASE time WHEN 'real' THEN 'rzeczywisty' WHEN 'estimated' THEN 'szacowany ±' || printf('%g', time_uncertainty_h) || ' h' ELSE 'zegar urządzenia' END AS czas,\n  start AS od, \"end\" AS do, printf('%.1f h', (\"end\" - start) / 3600.0) AS długość,\n  channel_dispense AS odsyp, channel_refill AS zasyp, channel_temperatures AS temperatury,\n  CASE checked WHEN 1 THEN 'tak' ELSE 'nie' END AS sprawdzony, legacy_name AS \"dawna nazwa\", id,\n  CAST(start * 1000 AS INTEGER) AS from_ms, CAST(\"end\" * 1000 AS INTEGER) + 1000 AS to_ms\nFROM period ORDER BY site, period_id",
                        "timeColumns": [
                          "od",
                          "do"
                        ]
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "okres"
                    },
                    "properties": [
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Pokaż okres",
                            "url": "/d/dms-periods-overview/?var-period=${__data.fields.id}&from=${__data.fields.from_ms}&to=${__data.fields.to_ms}"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "from_ms|to_ms|id"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "od|do"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "dateTimeAsIso"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Wskazania [kg] (min i max w przedziale) — ${period_label}",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "frser-sqlite-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "sqlite-periods"
                      },
                      "spec": {
                        "queryText": "WITH b AS (SELECT MAX(1.0, $__interval_ms / 1000.0) AS s)\nSELECT CAST(timestamp / b.s AS INTEGER) * b.s AS time, MIN(value) AS min, MAX(value) AS max\nFROM weight, b\nWHERE period = '${period}' AND timestamp >= (${__from} / 1000.0) AND timestamp < (${__to} / 1000.0)\nGROUP BY 1\nORDER BY 1",
                        "queryType": "time series",
                        "rawQueryText": "WITH b AS (SELECT MAX(1.0, $__interval_ms / 1000.0) AS s)\nSELECT CAST(timestamp / b.s AS INTEGER) * b.s AS time, MIN(value) AS min, MAX(value) AS max\nFROM weight, b\nWHERE period = '${period}' AND timestamp >= (${__from} / 1000.0) AND timestamp < (${__to} / 1000.0)\nGROUP BY 1\nORDER BY 1",
                        "timeColumns": [
                          "time"
                        ]
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "1s"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "custom": {
                    "lineWidth": 1,
                    "showPoints": "never",
                    "spanNulls": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "max"
                    },
                    "properties": [
                      {
                        "id": "custom.fillBelowTo",
                        "value": "min"
                      },
                      {
                        "id": "custom.fillOpacity",
                        "value": 30
                      },
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "blue",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "min"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "blue",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Sygnały surowe (pomarańczowe: stan aktywny)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "frser-sqlite-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "sqlite-periods"
                      },
                      "spec": {
                        "queryText": "WITH s AS (\n  SELECT pin, timestamp, state FROM signal_changes WHERE period = '${period}' AND kind = 'surowy'\n),\nbefore AS (\n  SELECT pin, state, MAX(timestamp) FROM s WHERE timestamp < (${__from} / 1000.0) GROUP BY pin\n),\ninside AS (\n  SELECT timestamp AS time, pin, state FROM s WHERE timestamp >= (${__from} / 1000.0) AND timestamp < (${__to} / 1000.0)\n),\nlast AS (\n  SELECT pin, state FROM (\n    SELECT pin, state, MAX(time) FROM (SELECT (${__from} / 1000.0) AS time, pin, state FROM before UNION ALL SELECT time, pin, state FROM inside)\n    GROUP BY pin\n  )\n)\nSELECT time, 'pin ' || pin || COALESCE(' (' || (SELECT role FROM signal_events e WHERE e.period = '${period}' AND e.pin = u.pin LIMIT 1) || ')', '') AS metric, state AS value FROM (\n  SELECT (${__from} / 1000.0) AS time, pin, state FROM before\n  UNION ALL SELECT time, pin, state FROM inside\n  UNION ALL SELECT (${__to} / 1000.0) AS time, pin, state FROM last\n) u\nORDER BY time, metric",
                        "queryType": "table",
                        "rawQueryText": "WITH s AS (\n  SELECT pin, timestamp, state FROM signal_changes WHERE period = '${period}' AND kind = 'surowy'\n),\nbefore AS (\n  SELECT pin, state, MAX(timestamp) FROM s WHERE timestamp < (${__from} / 1000.0) GROUP BY pin\n),\ninside AS (\n  SELECT timestamp AS time, pin, state FROM s WHERE timestamp >= (${__from} / 1000.0) AND timestamp < (${__to} / 1000.0)\n),\nlast AS (\n  SELECT pin, state FROM (\n    SELECT pin, state, MAX(time) FROM (SELECT (${__from} / 1000.0) AS time, pin, state FROM before UNION ALL SELECT time, pin, state FROM inside)\n    GROUP BY pin\n  )\n)\nSELECT time, 'pin ' || pin || COALESCE(' (' || (SELECT role FROM signal_events e WHERE e.period = '${period}' AND e.pin = u.pin LIMIT 1) || ')', '') AS metric, state AS value FROM (\n  SELECT (${__from} / 1000.0) AS time, pin, state FROM before\n  UNION ALL SELECT time, pin, state FROM inside\n  UNION ALL SELECT (${__to} / 1000.0) AS time, pin, state FROM last\n) u\nORDER BY time, metric",
                        "timeColumns": [
                          "time"
                        ]
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "partitionByValues",
                  "spec": {
                    "options": {
                      "fields": [
                        "metric"
                      ],
                      "keepFields": false,
                      "naming": {
                        "asLabels": true
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "state-timeline",
            "version": "",
            "spec": {
              "options": {
                "alignValue": "left",
                "legend": {
                  "displayMode": "list",
                  "showLegend": true
                },
                "mergeValues": true,
                "rowHeight": 0.8,
                "showValue": "never",
                "tooltip": {
                  "mode": "multi"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "displayName": "${__field.labels.metric}",
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "",
                          "color": "transparent",
                          "index": 0
                        },
                        "1": {
                          "text": "aktywny",
                          "color": "orange",
                          "index": 1
                        }
                      }
                    }
                  ],
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "transparent"
                  },
                  "custom": {
                    "fillOpacity": 85,
                    "lineWidth": 0,
                    "spanNulls": true
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Sygnały oczyszczone, obecny wariant reguł z ręcznymi zdarzeniami (zielone: zdarzenie, czerwone: odrzucone)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "frser-sqlite-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "sqlite-periods"
                      },
                      "spec": {
                        "queryText": "WITH s AS (\n  SELECT pin, timestamp, state FROM signal_changes WHERE period = '${period}' AND kind = 'zdarzenia'\n),\nbefore AS (\n  SELECT pin, state, MAX(timestamp) FROM s WHERE timestamp < (${__from} / 1000.0) GROUP BY pin\n),\ninside AS (\n  SELECT timestamp AS time, pin, state FROM s WHERE timestamp >= (${__from} / 1000.0) AND timestamp < (${__to} / 1000.0)\n),\nlast AS (\n  SELECT pin, state FROM (\n    SELECT pin, state, MAX(time) FROM (SELECT (${__from} / 1000.0) AS time, pin, state FROM before UNION ALL SELECT time, pin, state FROM inside)\n    GROUP BY pin\n  )\n)\nSELECT time, 'pin ' || pin || COALESCE(' (' || (SELECT role FROM signal_events e WHERE e.period = '${period}' AND e.pin = u.pin LIMIT 1) || ')', '') AS metric, state AS value FROM (\n  SELECT (${__from} / 1000.0) AS time, pin, state FROM before\n  UNION ALL SELECT time, pin, state FROM inside\n  UNION ALL SELECT (${__to} / 1000.0) AS time, pin, state FROM last\n) u\nORDER BY time, metric",
                        "queryType": "table",
                        "rawQueryText": "WITH s AS (\n  SELECT pin, timestamp, state FROM signal_changes WHERE period = '${period}' AND kind = 'zdarzenia'\n),\nbefore AS (\n  SELECT pin, state, MAX(timestamp) FROM s WHERE timestamp < (${__from} / 1000.0) GROUP BY pin\n),\ninside AS (\n  SELECT timestamp AS time, pin, state FROM s WHERE timestamp >= (${__from} / 1000.0) AND timestamp < (${__to} / 1000.0)\n),\nlast AS (\n  SELECT pin, state FROM (\n    SELECT pin, state, MAX(time) FROM (SELECT (${__from} / 1000.0) AS time, pin, state FROM before UNION ALL SELECT time, pin, state FROM inside)\n    GROUP BY pin\n  )\n)\nSELECT time, 'pin ' || pin || COALESCE(' (' || (SELECT role FROM signal_events e WHERE e.period = '${period}' AND e.pin = u.pin LIMIT 1) || ')', '') AS metric, state AS value FROM (\n  SELECT (${__from} / 1000.0) AS time, pin, state FROM before\n  UNION ALL SELECT time, pin, state FROM inside\n  UNION ALL SELECT (${__to} / 1000.0) AS time, pin, state FROM last\n) u\nORDER BY time, metric",
                        "timeColumns": [
                          "time"
                        ]
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "partitionByValues",
                  "spec": {
                    "options": {
                      "fields": [
                        "metric"
                      ],
                      "keepFields": false,
                      "naming": {
                        "asLabels": true
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "state-timeline",
            "version": "",
            "spec": {
              "options": {
                "alignValue": "left",
                "legend": {
                  "displayMode": "list",
                  "showLegend": true
                },
                "mergeValues": true,
                "rowHeight": 0.8,
                "showValue": "never",
                "tooltip": {
                  "mode": "multi"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "displayName": "${__field.labels.metric}",
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "",
                          "color": "transparent",
                          "index": 0
                        },
                        "2": {
                          "text": "zdarzenie",
                          "color": "green",
                          "index": 1
                        },
                        "3": {
                          "text": "odrzucone",
                          "color": "red",
                          "index": 2
                        }
                      }
                    }
                  ],
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "transparent"
                  },
                  "custom": {
                    "fillOpacity": 85,
                    "lineWidth": 0,
                    "spanNulls": true
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Temperatury [°C] (średnia w przedziale, bez usuniętych odczytów)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "frser-sqlite-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "sqlite-periods"
                      },
                      "spec": {
                        "queryText": "WITH b AS (SELECT MAX(1.0, $__interval_ms / 1000.0) AS s)\nSELECT CAST(timestamp / b.s AS INTEGER) * b.s AS time, 'czujnik ' || sensor AS metric, AVG(value) AS value\nFROM temperatures, b\nWHERE period = '${period}' AND timestamp >= (${__from} / 1000.0) AND timestamp < (${__to} / 1000.0)\nGROUP BY 1, 2\nORDER BY 1",
                        "queryType": "table",
                        "rawQueryText": "WITH b AS (SELECT MAX(1.0, $__interval_ms / 1000.0) AS s)\nSELECT CAST(timestamp / b.s AS INTEGER) * b.s AS time, 'czujnik ' || sensor AS metric, AVG(value) AS value\nFROM temperatures, b\nWHERE period = '${period}' AND timestamp >= (${__from} / 1000.0) AND timestamp < (${__to} / 1000.0)\nGROUP BY 1, 2\nORDER BY 1",
                        "timeColumns": [
                          "time"
                        ]
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "partitionByValues",
                  "spec": {
                    "options": {
                      "fields": [
                        "metric"
                      ],
                      "keepFields": false,
                      "naming": {
                        "asLabels": true
                      }
                    }
                  }
                }
              ],
              "queryOptions": {
                "interval": "1s"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "displayName": "${__field.labels.metric}",
                  "unit": "celsius",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "lineWidth": 1,
                    "showPoints": "never",
                    "spanNulls": false
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Zdarzenia w widocznym zakresie (klik w początek: przybliż ±30 s)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "frser-sqlite-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "sqlite-periods"
                      },
                      "spec": {
                        "queryText": "SELECT 'pin ' || pin || ' (' || role || ')' AS sygnał, start AS początek, \"end\" AS koniec, round(duration, 2) AS \"czas [s]\", pulse_count AS impulsy,\n  CASE WHEN rejected = 1 THEN 'odrzucone' ELSE 'przyjęte' END AS status, CASE WHEN synthetic = 1 THEN 'tak' ELSE '' END AS ręczne,\n  CAST((start - 30) * 1000 AS INTEGER) AS from_ms, CAST((\"end\" + 30) * 1000 AS INTEGER) AS to_ms\nFROM signal_events\nWHERE period = '${period}' AND start < (${__to} / 1000.0) AND \"end\" >= (${__from} / 1000.0)\nORDER BY start",
                        "queryType": "table",
                        "rawQueryText": "SELECT 'pin ' || pin || ' (' || role || ')' AS sygnał, start AS początek, \"end\" AS koniec, round(duration, 2) AS \"czas [s]\", pulse_count AS impulsy,\n  CASE WHEN rejected = 1 THEN 'odrzucone' ELSE 'przyjęte' END AS status, CASE WHEN synthetic = 1 THEN 'tak' ELSE '' END AS ręczne,\n  CAST((start - 30) * 1000 AS INTEGER) AS from_ms, CAST((\"end\" + 30) * 1000 AS INTEGER) AS to_ms\nFROM signal_events\nWHERE period = '${period}' AND start < (${__to} / 1000.0) AND \"end\" >= (${__from} / 1000.0)\nORDER BY start",
                        "timeColumns": [
                          "początek",
                          "koniec"
                        ]
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "from_ms|to_ms"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "początek"
                    },
                    "properties": [
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Przybliż",
